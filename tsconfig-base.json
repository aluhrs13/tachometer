{
  "compilerOptions": {
    "target": "es2017",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "preserveConstEnums": true,
    "skipLibCheck": true,

    "lib": ["esnext", "esnext.asynciterable"],

    "declaration": true,
    "sourceMap": true,
    "pretty": true
  }
}

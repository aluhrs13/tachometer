{
  "$schema": "../../config.schema.json",
  "sampleSize": 10,
  "timeout": 1,
  "autoSampleConditions": ["1%", "+100KiB"],
  "benchmarks": [
    {
      "name": "plain",
      "url": "plain.html",
      "browser": {
        "name": "chrome",
        "headless": true
      },
      "measurement": [
        {
          "mode": "expression",
          "name": "build-time",
          "expression": "window.tachometerResult"
        },
        {
          "mode": "memory",
          "name": "v8-heap",
          "metric": "v8/main/heap.size"
        },
        {
          "mode": "memory",
          "name": "malloc",
          "metric": "malloc.size"
        }
      ]
    },
    {
      "name": "wrapped",
      "url": "wrapped.html",
      "browser": {
        "name": "chrome",
        "headless": true
      },
      "measurement": [
        {
          "mode": "expression",
          "name": "build-time",
          "expression": "window.tachometerResult"
        },
        {
          "mode": "memory",
          "name": "v8-heap",
          "metric": "v8/main/heap.size"
        },
        {
          "mode": "memory",
          "name": "malloc",
          "metric": "malloc.size"
        }
      ]
    }
  ]
}

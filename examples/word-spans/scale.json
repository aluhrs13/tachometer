{
  "$schema": "../../config.schema.json",
  "sampleSize": 5,
  "timeout": 3,
  "autoSampleConditions": ["5%", "+512KiB"],
  "benchmarks": [
    {
      "name": "tiny (n=1000)",
      "url": "wrapped.html?n=1000",
      "browser": {
        "name": "chrome",
        "headless": true
      },
      "measurement": [
        {
          "mode": "expression",
          "name": "build-time",
          "expression": "window.tachometerResult"
        },
        {
          "mode": "memory",
          "name": "v8-heap",
          "metric": "v8/main/heap.size"
        },
        {
          "mode": "memory",
          "name": "blink-gc",
          "metric": "blink_gc.size"
        },
        {
          "mode": "memory",
          "name": "partition-alloc",
          "metric": "partition_alloc/allocated_objects.size"
        }
      ]
    },
    {
      "name": "huge (n=200000)",
      "url": "wrapped.html?n=200000",
      "browser": {
        "name": "chrome",
        "headless": true
      },
      "measurement": [
        {
          "mode": "expression",
          "name": "build-time",
          "expression": "window.tachometerResult"
        },
        {
          "mode": "memory",
          "name": "v8-heap",
          "metric": "v8/main/heap.size"
        },
        {
          "mode": "memory",
          "name": "blink-gc",
          "metric": "blink_gc.size"
        },
        {
          "mode": "memory",
          "name": "partition-alloc",
          "metric": "partition_alloc/allocated_objects.size"
        }
      ]
    }
  ]
}
